FLASK_APP=run.py
FLASK_DEBUG=False
SECRET_KEY=replace-with-at-least-32-random-characters
QR_SIGNING_SECRET=replace-with-a-different-32-character-random-value
DATABASE_URL=sqlite:///instance/attendance.db
# Set DB_HOST to use the MySQL settings below instead of DATABASE_URL.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL_MODE=REQUIRED
DATABASE_SSL_CA=
REQUIRE_DATABASE_URL=False
TRUST_PROXY=False
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
QR_TOKEN_TTL_SECONDS=30
SESSION_LIFETIME_MINUTES=30
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15
SECURITY_ALERT_THRESHOLD=10
ATTENDANCE_ELIGIBILITY_THRESHOLD=80
PASSWORD_RESET_TTL_MINUTES=30
RATE_LIMIT_DEFAULT=200 per hour
RATE_LIMIT_AUTH=20 per minute
RATELIMIT_STORAGE_URI=memory://
PUBLIC_BASE_URL=https://attendance.example.edu
MAIL_HOST=smtp.example.edu
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=True
MAIL_FROM=attendance@example.edu
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
